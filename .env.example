# Where the Request Order form posts its JSON. Leave empty to fall back to an
# email the visitor sends from their own mail app.
VITE_ORDER_ENDPOINT=

# Optional: the order dashboard API (/admin). Only set this if the dashboard API
# is not VITE_ORDER_ENDPOINT with /admin in place of /orders.
VITE_ADMIN_ENDPOINT=

# Firebase web app config for staff sign-in (/admin) and store content.
# Copy these from the Firebase console: Project settings, Your apps, Web app.
# They are public configuration, not secrets. In Vercel, set them under
# Project Settings, Environment Variables.
# Firebase holds staff sign-in, store content and daily figures only. It never
# holds customer details.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Shows the dashboard's Carts screen data. Leave empty: cart saving does not exist yet (README.md, Carts).
VITE_CART_SERVICE=
