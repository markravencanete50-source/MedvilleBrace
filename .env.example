# Where the Request Order form posts its JSON. Leave empty to fall back to an
# email the visitor sends from their own mail app.
VITE_ORDER_ENDPOINT=

# Order dashboard (/admin) sign-in: the DashboardClientId output of the AWS
# stack. Public configuration, not a secret.
VITE_COGNITO_CLIENT_ID=
# Optional: only if the dashboard API is not VITE_ORDER_ENDPOINT with /admin
# in place of /orders.
VITE_ADMIN_ENDPOINT=
