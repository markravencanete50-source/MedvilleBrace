# Copy to functions/.env (never committed) before `firebase deploy`.

# The site's live origins, comma-separated. Requests from anywhere else are refused.
ALLOWED_ORIGINS=https://www.REPLACE-WITH-FINAL-DOMAIN,https://REPLACE-WITH-FINAL-DOMAIN

# "New order request" emails (reference and item count only, never customer details).
NOTIFICATION_FROM=orders@REPLACE-WITH-FINAL-DOMAIN
ORDER_NOTIFY_TO=REPLACE-WITH-ORDER-INBOX

# Secrets are set with the CLI, not here:
#   firebase functions:secrets:set RATE_LIMIT_SECRET   (any long random string)
#   firebase functions:secrets:set RESEND_API_KEY
