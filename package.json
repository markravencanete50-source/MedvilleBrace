{
  "name": "medville-brace-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs && node scripts/strip-cdn-assets.mjs",
    "preview": "vite preview",
    "catalog:fetch": "node scripts/fetch-catalog.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "images:fetch": "node scripts/fetch-images.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "audit": "node scripts/audit-catalog.mjs",
    "images:upload": "node scripts/upload-cloudinary.mjs",
    "test:functions": "node --test functions/order.test.js",
    "deploy:cloudflare": "npm run build && npx wrangler@4 deploy",
    "deploy:functions": "firebase deploy --only functions:orders,firestore:rules"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "minisearch": "^7.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
